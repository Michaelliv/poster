{
  "name": "poster-ai",
  "version": "0.1.0",
  "description": "Single-file distributable React posters — one .tsx file, every format you'll ever need. Works as a CLI and as a library.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "poster": "./dist/main.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && bun run scripts/copy-runtime.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/install-browser.js || true",
    "dev": "bun run src/main.ts",
    "build:bun": "bun build --compile src/main.ts --outfile poster",
    "build:bun-linux": "bun build --compile --target=bun-linux-x64 src/main.ts --outfile poster-linux-x64",
    "build:bun-mac-arm": "bun build --compile --target=bun-darwin-arm64 src/main.ts --outfile poster-darwin-arm64",
    "build:bun-mac-x64": "bun build --compile --target=bun-darwin-x64 src/main.ts --outfile poster-darwin-x64",
    "test": "bun test",
    "format": "bunx biome format --write src/",
    "lint": "bunx biome lint src/",
    "check": "bunx biome check src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michaelliv/poster.git"
  },
  "homepage": "https://github.com/Michaelliv/poster#readme",
  "bugs": {
    "url": "https://github.com/Michaelliv/poster/issues"
  },
  "keywords": ["react", "png-export", "single-file", "distributable", "charts", "recharts", "puppeteer"],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.13.0",
    "@zumer/snapdom": "^2.8.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "esbuild": "^0.24.0",
    "lucide-react": "^1.8.0",
    "puppeteer-core": "^24.41.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1"
  }
}
